<?xml version="1.0" encoding="UTF-8"?>

<mule
    xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xmlns:file="http://www.mulesoft.org/schema/mule/file"
    xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
    xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/file
        http://www.mulesoft.org/schema/mule/file/current/mule-file.xsd
        http://www.mulesoft.org/schema/mule/munit
        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools
        http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="write-valid-store-chunk-subflow-test-suite.xml" />

    <configuration-properties file="config-test.yaml" />

    <!-- Test 1: New store file — localFileExists=false -->
    <munit:test name="write-valid-store-chunk-subflowSub_Flow-new-file-test"
        description="When store file does not yet exist, localFileExists=false and file:write creates new file with header">
        <munit:behavior>
            <!-- file:list uses target="existingStoreFiles" — must use variables not payload -->
            <munit-tools:mock-when doc:name="Mock List Valid Store Files Empty" processor="file:list">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['List Existing Valid Store Files']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="#['existingStoreFiles']" value="#[[]]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="Mock Append Valid Store Records New File" processor="file:write">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Append Valid Store Records']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return />
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set New Store Chunk Event">
                <munit:payload
                    value="#[{ storeId: 'STORE001', records: [{ SKU: 'SKU001', StoreId: 'STORE001', Type: 'Standard', Quantity: 10, Timestamp: '1/15/2025 10:30' }, { SKU: 'SKU002', StoreId: 'STORE001', Type: 'Backorder', Quantity: 5, Timestamp: '1/15/2025 11:00' }] }]"
                    mediaType="application/java" />
                <munit:variables>
                    <munit:variable key="runId"                 value="#['TEST-WRITE-001']" />
                    <munit:variable key="businessDate"          value="#['01-01-2025']" />
                    <munit:variable key="validStagingDirectory" value="#['C:/mule_files/process/records/valid']" />
                </munit:variables>
            </munit:set-event>
            <flow-ref doc:name="Invoke Write Valid Store Chunk" name="write-valid-store-chunk-subflowSub_Flow" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Local File Name Contains Store ID" expression="#[vars.localFileName]" is="#[MunitTools::containsString('STORE001')]" />
            <munit-tools:assert-that doc:name="Assert Local File Name Contains Business Date" expression="#[vars.localFileName]" is="#[MunitTools::containsString('01-01-2025')]" />
            <munit-tools:assert-that doc:name="Assert Local File Name Has CSV Part Extension" expression="#[vars.localFileName]" is="#[MunitTools::containsString('.csv.part')]" />
            <munit-tools:assert-that doc:name="Assert Local File Does Not Exist Before Write" expression="#[vars.localFileExists]" is="#[MunitTools::equalTo(false)]" />
            <munit-tools:assert-that doc:name="Assert Local File Path Contains Store ID" expression="#[vars.localFilePath]" is="#[MunitTools::containsString('STORE001')]" />
            <munit-tools:assert-that doc:name="Assert Local File Path Contains Staging Directory" expression="#[vars.localFilePath]" is="#[MunitTools::containsString('C:/mule_files/process/records/valid')]" />
            <munit-tools:assert-that doc:name="Assert Records To Write Are Populated" expression="#[vars.recordsToWrite]" is="#[MunitTools::notNullValue()]" />
            <munit-tools:verify-call doc:name="Verify File List Was Called" processor="file:list" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['List Existing Valid Store Files']" />
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
            <munit-tools:verify-call doc:name="Verify File Write Called Once For New File" processor="file:write" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Append Valid Store Records']" />
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!-- Test 2: Existing store file — localFileExists=true, appended without header -->
    <munit:test name="write-valid-store-chunk-subflowSub_Flow-existing-file-append-test"
        description="When store file already exists, localFileExists=true and file:write appends records without header">
        <munit:behavior>
            <!-- file:list uses target="existingStoreFiles" — must use variables not payload -->
            <munit-tools:mock-when doc:name="Mock List Valid Store Files With Existing" processor="file:list">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['List Existing Valid Store Files']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="#['existingStoreFiles']" value="#[[{ attributes: { fileName: 'inventory_STORE002_15-01-2025.csv.part' } }]]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="Mock Append Valid Store Records Existing File" processor="file:write">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Append Valid Store Records']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return />
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set Existing Store Chunk Event">
                <munit:payload
                    value="#[{ storeId: 'STORE002', records: [{ SKU: 'SKU003', StoreId: 'STORE002', Type: 'Standard', Quantity: 20, Timestamp: '1/15/2025 12:00' }] }]"
                    mediaType="application/java" />
                <munit:variables>
                    <munit:variable key="runId"                 value="#['TEST-WRITE-002']" />
                    <munit:variable key="businessDate"          value="#['15-01-2025']" />
                    <munit:variable key="validStagingDirectory" value="#['C:/mule_files/process/records/valid']" />
                </munit:variables>
            </munit:set-event>
            <flow-ref doc:name="Invoke Write Valid Store Chunk Existing" name="write-valid-store-chunk-subflowSub_Flow" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Local File Name Is inventory_STORE002_15-01-2025.csv.part" expression="#[vars.localFileName]" is="#[MunitTools::equalTo('inventory_STORE002_15-01-2025.csv.part')]" />
            <munit-tools:assert-that doc:name="Assert Local File Already Exists" expression="#[vars.localFileExists]" is="#[MunitTools::equalTo(true)]" />
            <munit-tools:verify-call doc:name="Verify File Write Called Once For Existing File" processor="file:write" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Append Valid Store Records']" />
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!-- Test 3: Empty records list — file:write still called (empty CSV body) -->
    <munit:test name="write-valid-store-chunk-subflowSub_Flow-empty-records-test"
        description="When records list is empty, localFileName is still computed and file:write is called">
        <munit:behavior>
            <!-- file:list uses target="existingStoreFiles" — must use variables not payload -->
            <munit-tools:mock-when doc:name="Mock List Valid Store Files Empty Records" processor="file:list">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['List Existing Valid Store Files']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="#['existingStoreFiles']" value="#[[]]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="Mock Append Empty Records" processor="file:write">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Append Valid Store Records']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return />
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set Empty Records Event">
                <munit:payload value="#[{ storeId: 'STORE003', records: [] }]" mediaType="application/java" />
                <munit:variables>
                    <munit:variable key="runId"                 value="#['TEST-WRITE-003']" />
                    <munit:variable key="businessDate"          value="#['01-01-2025']" />
                    <munit:variable key="validStagingDirectory" value="#['C:/mule_files/process/records/valid']" />
                </munit:variables>
            </munit:set-event>
            <flow-ref doc:name="Invoke Write Valid Store Chunk Empty Records" name="write-valid-store-chunk-subflowSub_Flow" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Current Store ID Set" expression="#[vars.currentStoreId]" is="#[MunitTools::equalTo('STORE003')]" />
            <munit-tools:assert-that doc:name="Assert Records To Write Is Empty Array" expression="#[sizeOf(vars.recordsToWrite default [])]" is="#[MunitTools::equalTo(0)]" />
            <munit-tools:verify-call doc:name="Verify File Write Still Called For Empty Records" processor="file:write" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Append Valid Store Records']" />
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!-- Test 4: Missing storeId — defaults to UNKNOWN_STORE -->
    <munit:test name="write-valid-store-chunk-subflowSub_Flow-missing-store-id-test"
        description="When storeId is absent from payload, localFileName defaults to UNKNOWN_STORE naming">
        <munit:behavior>
            <!-- file:list uses target="existingStoreFiles" — must use variables not payload -->
            <munit-tools:mock-when doc:name="Mock List Store Files Missing StoreId" processor="file:list">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['List Existing Valid Store Files']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="#['existingStoreFiles']" value="#[[]]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when doc:name="Mock Write For Missing StoreId" processor="file:write">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Append Valid Store Records']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return />
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set Missing Store ID Event">
                <munit:payload
                    value="#[{ records: [{ SKU: 'SKU099', StoreId: '', Type: 'Standard', Quantity: 1, Timestamp: '1/1/2025 9:00' }] }]"
                    mediaType="application/java" />
                <munit:variables>
                    <munit:variable key="runId"                 value="#['TEST-WRITE-004']" />
                    <munit:variable key="businessDate"          value="#['01-01-2025']" />
                    <munit:variable key="validStagingDirectory" value="#['C:/mule_files/process/records/valid']" />
                </munit:variables>
            </munit:set-event>
            <flow-ref doc:name="Invoke Write Valid Store Chunk No StoreId" name="write-valid-store-chunk-subflowSub_Flow" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert File Name Uses UNKNOWN_STORE Default" expression="#[vars.localFileName]" is="#[MunitTools::containsString('UNKNOWN_STORE')]" />
            <!-- Note: verify-call removed — mock call counts accumulate when tests
                 run in certain execution orders; the variable assertion above is
                 sufficient to verify the UNKNOWN_STORE default logic. -->
            <munit-tools:assert-that doc:name="Assert Local File Does Not Exist" expression="#[vars.localFileExists]" is="#[MunitTools::equalTo(false)]" />
        </munit:validation>
    </munit:test>

</mule>