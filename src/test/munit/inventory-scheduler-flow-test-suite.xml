<?xml version="1.0" encoding="UTF-8"?>

<mule
    xmlns="http://www.mulesoft.org/schema/mule/core"
    xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
    xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp"
    xmlns:email="http://www.mulesoft.org/schema/mule/email"
    xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
    xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/sftp
        http://www.mulesoft.org/schema/mule/sftp/current/mule-sftp.xsd
        http://www.mulesoft.org/schema/mule/email
        http://www.mulesoft.org/schema/mule/email/current/mule-email.xsd
        http://www.mulesoft.org/schema/mule/munit
        http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools
        http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="inventory-scheduler-flow-test-suite.xml" />

    <configuration-properties file="config-test.yaml" />

    <!-- Test 1: Scheduler trigger with missing source file
         Covers: ee:transform (Initialize Scheduler Run Context), logger,
         flow-ref to inventory-processing-flowFlow, MISSING_SOURCE_FILE path,
         SCHEDULER notification email (email sent for SCHEDULER + MISSING_SOURCE) -->
    <munit:test name="inventory-scheduler-flowFlow-missing-source-test"
        description="Scheduler trigger initializes SCHEDULER context and sends MISSING_SOURCE_FILE notification">
        <munit:behavior>
            <!-- sftp:list returns empty — triggers MISSING_SOURCE_FILE path -->
            <munit-tools:mock-when processor="sftp:list" doc:name="Mock Empty Source For Scheduler">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['List Source Directory']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="#['availableSourceFiles']" value="#[[]]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <!-- SCHEDULER + MISSING_SOURCE_FILE → sends email notification -->
            <munit-tools:mock-when processor="email:send" doc:name="Mock Missing Source Email For Scheduler">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Send Inventory Notification']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return />
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <!-- No variables pre-set — ee:transform in the flow sets all context variables -->
            <munit:set-event doc:name="Set Scheduler Trigger Event" />
            <flow-ref name="inventory-scheduler-flowFlow" doc:name="Invoke Scheduler Flow" />
        </munit:execution>
        <munit:validation>
            <!-- triggerType is set by ee:transform in the scheduler flow -->
            <munit-tools:assert-that doc:name="Assert Trigger Type Is SCHEDULER" expression="#[vars.triggerType]" is="#[MunitTools::equalTo('SCHEDULER')]" />
            <!-- runId is generated by ee:transform -->
            <munit-tools:assert-that doc:name="Assert Run Id Not Null" expression="#[vars.runId]" is="#[MunitTools::notNullValue()]" />
            <munit-tools:assert-that doc:name="Assert Run Id Starts With INV" expression="#[vars.runId]" is="#[MunitTools::containsString('INV-')]" />
            <!-- businessDate is set by ee:transform -->
            <munit-tools:assert-that doc:name="Assert Business Date Not Null" expression="#[vars.businessDate]" is="#[MunitTools::notNullValue()]" />
            <!-- sourceFilePath uses today's date in inbound/inventory_DD-MM-YYYY.csv format -->
            <munit-tools:assert-that doc:name="Assert Source File Path Contains Inbound" expression="#[vars.sourceFilePath]" is="#[MunitTools::containsString('inbound/inventory_')]" />
            <munit-tools:assert-that doc:name="Assert Source File Path Ends With CSV" expression="#[vars.sourceFilePath]" is="#[MunitTools::containsString('.csv')]" />
            <!-- Processing result: MISSING_SOURCE_FILE -->
            <munit-tools:assert-that doc:name="Assert Missing Source Status" expression="#[vars.runStatus]" is="#[MunitTools::equalTo('MISSING_SOURCE_FILE')]" />
            <!-- SCHEDULER + MISSING_SOURCE_FILE → email notification sent once -->
            <munit-tools:verify-call processor="email:send" times="1" doc:name="Verify Missing Source Email Sent For Scheduler">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Send Inventory Notification']" />
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!-- Test 2: Scheduler already running (another execution active)
         Covers: lock conflict path via scheduler trigger — no email sent for ALREADY_RUNNING -->
    <munit:test name="inventory-scheduler-flowFlow-already-running-test"
        description="Scheduler trigger with active lock produces ALREADY_RUNNING without notification">
        <munit:behavior>
            <!-- Source file found — filename must match today's dynamic date (same format scheduler uses) -->
            <munit-tools:mock-when processor="sftp:list" doc:name="Mock Source Available For Scheduler Lock Test">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['List Source Directory']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="#['availableSourceFiles']" value="#[[{ attributes: { fileName: 'inventory_' ++ ((now() >> ('Asia/Kolkata' as TimeZone)) as String { format: 'dd-MM-yyyy' }) ++ '.csv' } }]]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <!-- Lock conflict: another execution is active -->
            <munit-tools:mock-when processor="os:store" doc:name="Mock Active Lock Conflict For Scheduler">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Create Active Run Lock']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:error typeId="OS:KEY_ALREADY_EXISTS" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <!-- Retrieve fresh existing lock (startedAt=2099 → NOT stale) -->
            <munit-tools:mock-when processor="os:retrieve" doc:name="Mock Fresh Lock For Scheduler">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Retrieve Existing Active Run Lock']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="#['existingActiveRunLock']" value="#[{ runId: 'PREV-SCHEDULER-RUN', triggerType: 'SCHEDULER', status: 'PROCESSING', startedAt: '2099-01-01T00:00:00.000+05:30' }]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <!-- Email mock (should NOT be called for ALREADY_RUNNING) -->
            <munit-tools:mock-when processor="email:send" doc:name="Mock Email For Scheduler Lock Test">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Send Inventory Notification']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return />
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Set Scheduler Already Running Event" />
            <flow-ref name="inventory-scheduler-flowFlow" doc:name="Invoke Scheduler Flow Already Running" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that doc:name="Assert Trigger Type Is SCHEDULER" expression="#[vars.triggerType]" is="#[MunitTools::equalTo('SCHEDULER')]" />
            <munit-tools:assert-that doc:name="Assert Run Id Generated" expression="#[vars.runId]" is="#[MunitTools::notNullValue()]" />
            <munit-tools:assert-that doc:name="Assert Already Running Status" expression="#[vars.runStatus]" is="#[MunitTools::equalTo('ALREADY_RUNNING')]" />
            <munit-tools:assert-that doc:name="Assert Lock Not Acquired" expression="#[vars.lockAcquired default false]" is="#[MunitTools::equalTo(false)]" />
            <!-- No email for ALREADY_RUNNING -->
            <munit-tools:verify-call processor="email:send" times="0" doc:name="Verify No Email For Already Running">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Send Inventory Notification']" />
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

</mule>